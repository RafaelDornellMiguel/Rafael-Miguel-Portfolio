# Copie para .env.local (nunca comite .env.local).
# Sem DATABASE_URL o formulário de contato continua funcionando:
# o lead segue para o WhatsApp e a API responde persisted:false.

# Postgres (Supabase ou outro). TLS é verificado sempre.
DATABASE_URL=

# Opcional: CA própria do provedor, em PEM.
# Use isto se o certificado do banco não for assinado por uma CA pública —
# nunca desligue a verificação de certificado.
DATABASE_CA_CERT=

# ── Painel administrativo (/admin) ────────────────────────────────────────────
# OAuth do GitHub: crie em https://github.com/settings/developers
#   Homepage URL:               https://rafael-miguel-portfolio.vercel.app
#   Authorization callback URL: https://rafael-miguel-portfolio.vercel.app/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Única conta que pode entrar no painel. Vazio = ninguém entra (falha fechada).
ADMIN_GITHUB_LOGIN=RafaelDornellMiguel

# Segredo de assinatura da sessão. Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL pública do site (a Vercel preenche sozinha em produção).
NEXTAUTH_URL=

# ── Monitoramento de acessos ──────────────────────────────────────────────────
# Sal do pseudônimo de visitante. Sem ele, a coleta é desligada.
# Gere com: openssl rand -base64 32  — e NUNCA reutilize em outro projeto.
ANALYTICS_SALT=
